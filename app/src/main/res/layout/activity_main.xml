<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B0F0C"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Top Bar: Score & Lives -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#3A2019"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCORE: 0"
                android:textColor="#FFD54F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ ❤️ ❤️"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- CUSTOMER CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardElevation="6dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvCustomerAvatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="👧"
                    android:textSize="42sp"
                    android:gravity="center"
                    android:background="#FFE0B2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer: Maya"
                        android:textColor="#3E2723"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrderBubble"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 'Classic Waffle + 🍓 + ⚪'"
                        android:textColor="#D84315"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- VISUAL WAFFLE PLATE -->
        <androidx.cardview.widget.CardView
            android:layout_width="270dp"
            android:layout_height="220dp"
            app:cardCornerRadius="120dp"
            app:cardBackgroundColor="#E0E0E0"
            app:cardElevation="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#FFF3E0"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvPlateBase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️"
                    android:textSize="55sp" />

                <TextView
                    android:id="@+id/tvPlateToppingsVisual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="32sp"
                    android:gravity="center"
                    android:paddingTop="2dp" />

                <TextView
                    android:id="@+id/tvPlateToppingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select base &amp; toppings below..."
                    android:textColor="#8D6E63"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingTop="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- INGREDIENTS SELECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Choose Waffle Base:"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnClassicBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧇 Classic"
                android:backgroundTint="#8D6E63"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnChocoBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍫 Choco"
                android:backgroundTint="#4E342E"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnRedBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔴 Red Velvet"
                android:backgroundTint="#B71C1C"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Add Fruits &amp; Bonbons:"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnStrawberry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍓 Strawb."
                android:backgroundTint="#C2185B"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnBanana"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍌 Banana"
                android:backgroundTint="#F57F17"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnBonbon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍬 Bonbon"
                android:backgroundTint="#7B1FA2"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Add Sauces &amp; Extras:"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnNutella"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍫 Nutella"
                android:backgroundTint="#3E2723"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnWhiteChoco"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚪ White Choco"
                android:backgroundTint="#F5F5F5"
                android:textColor="#3E2723"
                android:textSize="9sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnIceCream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍨 Ice Cream"
                android:backgroundTint="#0277BD"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ACTION CONTROLS -->
        <Button
            android:id="@+id/btnServe"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="✅ SERVE WAFFLE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑️ TRASH"
                android:backgroundTint="#C62828"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnNewGame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔄 RESTART"
                android:backgroundTint="#0277BD"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>