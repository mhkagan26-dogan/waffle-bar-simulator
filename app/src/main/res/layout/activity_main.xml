<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120A07"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 1. RESTAURANT AWNING / TENTE BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B71C1C"
            android:padding="8dp"
            android:gravity="center"
            android:elevation="4dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎪 WAFFLE BAR CAFE &amp; DINER 🎪"
                android:textColor="#FFF8E1"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. TOP BAR: SCORE & LIVES (Diner Dashboard) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2E1B14"
            android:padding="8dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCORE: 0"
                android:textColor="#FFD54F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ ❤️ ❤️"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 3. RESTAURANT BOOTH / CUSTOMER WINDOW -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#3E2723"
            app:cardElevation="6dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="2dp">

                <!-- Window Frame Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🪟 CUSTOMER ORDER WINDOW"
                    android:textColor="#FFB74D"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#FFF8E1"
                    android:padding="10dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCustomerAvatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="👧"
                        android:textSize="38sp"
                        android:gravity="center"
                        android:background="#FFE0B2" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:id="@+id/tvCustomerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Customer: Maya"
                            android:textColor="#3E2723"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderBubble"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💬 'Classic Waffle + 🍓 + ⚪'"
                            android:textColor="#D84315"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:paddingTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. WOODEN BAR COUNTER (Restoran Servis Tezgahı) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#4E342E"
            app:cardElevation="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪵 SERVING COUNTER"
                    android:textColor="#D7CCC8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />

                <!-- Plate Circle on Counter -->
                <androidx.cardview.widget.CardView
                    android:layout_width="250dp"
                    android:layout_height="190dp"
                    app:cardCornerRadius="95dp"
                    app:cardBackgroundColor="#FFF3E0"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="6dp">

                        <TextView
                            android:id="@+id/tvPlateBase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍽️"
                            android:textSize="48sp" />

                        <TextView
                            android:id="@+id/tvPlateToppingsVisual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="28sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvPlateToppingsText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select base &amp; toppings below..."
                            android:textColor="#8D6E63"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingTop="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 5. KITCHEN PREP TRAY (Mutfak Malzeme Hazırlık Tezgahı) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E100C"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👨‍🍳 KITCHEN PREP STATION:"
                android:textColor="#FFD54F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <!-- Category 1: Base -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnClassicBase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🧇 Classic"
                    android:backgroundTint="#8D6E63"
                    android:textSize="10sp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnChocoBase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍫 Choco"
                    android:backgroundTint="#4E342E"
                    android:textSize="10sp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnRedBase"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 Red Velvet"
                    android:backgroundTint="#B71C1C"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Category 2: Fruits -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnStrawberry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍓 Strawb."
                    android:backgroundTint="#C2185B"
                    android:textSize="10sp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnBanana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍌 Banana"
                    android:backgroundTint="#F57F17"
                    android:textSize="10sp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnBonbon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍬 Bonbon"
                    android:backgroundTint="#7B1FA2"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Category 3: Sauces -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnNutella"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍫 Nutella"
                    android:backgroundTint="#3E2723"
                    android:textSize="10sp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnWhiteChoco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚪ White Choco"
                    android:backgroundTint="#F5F5F5"
                    android:textColor="#3E2723"
                    android:textSize="9sp"
                    android:layout_marginEnd="2dp" />

                <Button
                    android:id="@+id/btnIceCream"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🍨 Ice Cream"
                    android:backgroundTint="#0277BD"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- ACTION CONTROLS -->
            <Button
                android:id="@+id/btnServe"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✅ SERVE TO CUSTOMER"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#2E7D32"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗑️ TRASH"
                    android:backgroundTint="#C62828"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnNewGame"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔄 RESTART"
                    android:backgroundTint="#0277BD"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>