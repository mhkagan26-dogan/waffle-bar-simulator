<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- App Title & Ambience -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐟 Fish Nutrition &amp; Omega-3 Tracker"
            android:textColor="#006064"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Scoreboard (Points Management) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00838F"
            android:padding="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL OMEGA-3: 0 PTS"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Customer & Goal Section (Visual Details & Characters) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:orientation="vertical"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍🍳 Customer: Chef Alex"
                android:textColor="#212121"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal: Needs high Omega-3 meal (Target: 15+ PTS)"
                android:textColor="#D32F2F"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected: No fish added yet"
                android:textColor="#757575"
                android:textSize="13sp"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Fish Selection Menu (Diversity of Meals) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Select Fish for Nutrition Meal:"
            android:textColor="#006064"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Row 1: Palamut & Levrek -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnPalamut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🐟 Bonito (+5 PTS)"
                android:backgroundTint="#0097A7"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnLevrek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🐟 Sea Bass (+2 PTS)"
                android:backgroundTint="#0097A7"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Row 2: Orkinos & Sardalya -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnOrkinos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🐟 Tuna (+10 PTS)"
                android:backgroundTint="#00838F"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSardalya"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🐟 Sardine (+4 PTS)"
                android:backgroundTint="#00838F"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btnServe"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="✅ SERVE NUTRITION MEAL"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnNextCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 NEXT CUSTOMER"
            android:backgroundTint="#0288D1" />

    </LinearLayout>
</ScrollView>