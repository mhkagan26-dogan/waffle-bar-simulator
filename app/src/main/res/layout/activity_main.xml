<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2D1B14"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Top Bar: Score & Lives -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#42281D"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCORE: 0"
                android:textColor="#FFD54F"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="❤️ ❤️ ❤️"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- CUSTOMER AREA (Top) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardElevation="6dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- Customer Avatar -->
                <TextView
                    android:id="@+id/tvCustomerAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:text="👧"
                    android:textSize="45sp"
                    android:gravity="center"
                    android:background="#FFE0B2" />

                <!-- Speech Bubble -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tvCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer: Maya"
                        android:textColor="#3E2723"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOrderBubble"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 'I want a Choco Waffle with Strawberry &amp; Nutella!'"
                        android:textColor="#D84315"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        android:paddingTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CENTRAL WAFFLE PLATE (Middle Visual Display) -->
        <androidx.cardview.widget.CardView
            android:layout_width="260dp"
            android:layout_height="220dp"
            app:cardCornerRadius="110dp"
            app:cardBackgroundColor="#E0E0E0"
            app:cardElevation="10dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#F5F5F5"
                android:padding="10dp">

                <!-- Dynamic Waffle Base Display -->
                <TextView
                    android:id="@+id/tvPlateBase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍽️ EMPTY PLATE"
                    android:textSize="36sp" />

                <!-- Dynamic Toppings Display -->
                <TextView
                    android:id="@+id/tvPlateToppings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select ingredients below..."
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- INGREDIENT SELECTION TRAY (Bottom) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Choose Base:"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnClassicBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧇 Classic"
                android:backgroundTint="#8D6E63"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnChocoBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍫 Choco"
                android:backgroundTint="#4E342E"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnRedBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔴 Red Velvet"
                android:backgroundTint="#B71C1C"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Add Fruits &amp; Toppings:"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnStrawberry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍓 Strawb."
                android:backgroundTint="#C2185B"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnBanana"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍌 Banana"
                android:backgroundTint="#F57F17"
                android:textSize="10sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnNutella"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍫 Nutella"
                android:backgroundTint="#3E2723"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ACTION BUTTONS -->
        <Button
            android:id="@+id/btnServe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✅ SERVE WAFFLE"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗑️ TRASH"
                android:backgroundTint="#C62828"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnNewGame"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔄 RESTART"
                android:backgroundTint="#0277BD"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>