<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E1"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧇 Master Waffle Bar Simulator"
            android:textColor="#3E2723"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <!-- Scoreboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#4E342E"
            android:padding="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvTotalScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL CHEF SCORE: 0 PTS"
                android:textColor="#FFD54F"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWaffleCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waffles Served: 0"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:paddingTop="2dp" />
        </LinearLayout>

        <!-- Customer Ticket Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:orientation="vertical"
            android:elevation="3dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Customer: Emily (Berry Lover)"
                android:textColor="#3E2723"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrderGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order Goal: Wants Strawberries or Blueberries (+10 Bonus PTS)"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFE0B2"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvCurrentBuild"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Plate: Empty Waffle Plate"
                android:textColor="#5D4037"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCurrentPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waffle Value: 0 PTS"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="2dp" />
        </LinearLayout>

        <!-- Category 1: Waffle Base -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1️⃣ Select Waffle Base:"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnClassicBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧇 Classic (+5)"
                android:backgroundTint="#6D4C41"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnChocoBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍫 Choco (+8)"
                android:backgroundTint="#6D4C41"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnBubbleBase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍳 Bubble (+10)"
                android:backgroundTint="#6D4C41"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Category 2: Fruits & Toppings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2️⃣ Add Fresh Fruits:"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnStrawberry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍓 Strawberry (+6)"
                android:backgroundTint="#C62828"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnBanana"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍌 Banana (+4)"
                android:backgroundTint="#F57F17"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnKiwi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🥝 Kiwi (+5)"
                android:backgroundTint="#2E7D32"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Category 3: Sauces & Extras -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3️⃣ Add Sauces &amp; Extras:"
            android:textColor="#3E2723"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnNutella"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍫 Nutella (+7)"
                android:backgroundTint="#4E342E"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnMaple"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍯 Maple (+5)"
                android:backgroundTint="#EF6C00"
                android:textSize="11sp"
                android:layout_marginEnd="2dp" />

            <Button
                android:id="@+id/btnIceCream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍨 Ice Cream (+8)"
                android:backgroundTint="#0277BD"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Action Controls -->
        <Button
            android:id="@+id/btnServe"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🧇 SERVE WAFFLE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧹 CLEAR PLATE"
                android:backgroundTint="#C62828"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnNextCustomer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔄 NEXT CUSTOMER"
                android:backgroundTint="#1565C0"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>